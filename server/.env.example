# Copy this file to server/.env and fill in real values. Never commit server/.env.
# With NODE_ENV=production the server refuses to start without CORS_ORIGIN and
# FIREBASE_PROJECT_ID, and with FIREBASE_AUTH_EMULATOR_HOST set (src/config.ts).

# Port the chat server listens on.
PORT=3001

# Postgres connection string (e.g. from Neon or Supabase).
DATABASE_URL=postgres://user:password@host:5432/anibeam

# Web app origin(s) allowed to call this server, comma-separated. Each is written as a browser
# sends it: http:// or https://, the host, a port if any, and no path or / at the end. A *
# matches no page, so list each origin. In production each is https://, but for localhost and
# 127.0.0.1. Unset outside production, it means http://localhost:5173, the web dev server.
CORS_ORIGIN=http://localhost:5173

# Firebase project whose "Sign in with Google" ID tokens the server takes. Not a secret: the
# server checks tokens against Google's public keys, so it needs no service-account key.
FIREBASE_PROJECT_ID=your-project-id

# Leave this unset unless a proxy or load balancer sits in front of the server. Then set it to
# the proxy's address (such as 10.0.0.2, or several comma-separated), or to 1 for one hop, and
# the server takes each client's IP from the rightmost X-Forwarded-For entry, the one that proxy
# added, for its connection limit. 1 trusts whatever connects, so use it only when nothing can
# reach the server but through the proxy. true, or anything else, stops the start: true trusts
# the leftmost entry, which any client can write.
TRUST_PROXY=
