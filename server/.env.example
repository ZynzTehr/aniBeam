# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Port the chat server listens on.
PORT=3001

# Postgres connection string (e.g. from Neon or Supabase).
DATABASE_URL=postgres://user:password@host:5432/anibeam

# Web app origin(s) allowed to call this server, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Firebase project used to verify "Sign in with Google" ID tokens.
FIREBASE_PROJECT_ID=your-project-id

# Path to the Firebase service-account JSON key (gitignored; keep it outside the repo if you can).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
